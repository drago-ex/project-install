{
	"name": "drago-ex/project-install",
	"type": "drago-tools-resource",
	"description": "Application installation package.",
	"license": ["MIT"],
	"require": {
		"php": ">=8.3 <9",
		"drago-ex/bootstrap": "^2.0",
		"drago-ex/translator": "^3.0",
		"drago-ex/migration": "^2.0",
		"drago-ex/application": "^2.0",
		"drago-ex/component": "^2.0",
		"drago-ex/form": "^2.0",
		"drago-ex/database": "^3.0",
		"drago-ex/project-docker": "^2.0",
		"drago-ex/project-docker-db": "^2.0",
		"drago-ex/project-front": "^2.0",
		"drago-ex/project-auth": "^2.0",
		"drago-ex/project-backend": "^2.0",
		"drago-ex/project-backend-ui": "^2.0",
		"drago-ex/project-permission": "^1.0",
		"drago-ex/project-settings": "^1.0",
		"drago-ex/project-preset": "^1.0"
	},
	"autoload": {
		"classmap": ["src/"]
	},
	"extra": {
		"drago-tools": {
			"install": {
				"copy": {
					"resources/app/Install": "app/Install",
					"resources/assets": "assets"
				},
				"replace-once": true,
				"replace-priority": 400,
				"replace": {
					"resources/app/Bootstrap.php": "app",
					"resources/app/app.neon": "app",
					"resources/www": "www"
				}
			}
		}
	},
	"require-dev": {
		"phpstan/phpstan-nette": "^2.0",
		"drago-ex/project-tools": "^1.0"
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"post-install-cmd": [
			"drago-install --dev",
			"drago-clean"
		],
		"post-update-cmd": [
			"drago-install --dev",
			"drago-clean"
		]
	}
}
