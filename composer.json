{
	"name": "drago-ex/project-install",
	"description": "Application installation package.",
	"type": "drago-tools-resource",
	"license": "MIT",
	"require": {
		"php": ">=8.3 <9",
		"drago-ex/bootstrap": "^2.0",
		"drago-ex/translator": "^4.0.1",
		"drago-ex/migration": "^1.0",
		"drago-ex/application": "^4.0",
		"drago-ex/component": "^3.0",
		"drago-ex/form": "^3.0",
		"drago-ex/database": "^4.0",
		"drago-ex/project-docker": "^1.0",
		"drago-ex/project-docker-db": "^1.0",
		"drago-ex/project-front": "^3.0",
		"drago-ex/project-auth": "^1.0",
		"drago-ex/project-backend": "^1.0",
		"drago-ex/project-backend-ui": "^1.0",
		"drago-ex/project-settings": "^1.0"
	},
	"require-dev": {
		"phpstan/phpstan-nette": "^2.0",
		"drago-ex/project-tools": "^1.0",
		"nette/tester": "^2.5"
	},
	"autoload": {
		"classmap": [
			"src/"
		]
	},
	"extra": {
		"drago-tools": {
			"install": {
				"copy": {
					"resources/app/Presentation/Install": "app/Presentation/Install",
					"resources/assets": "assets"
				},
				"replace-once": true,
				"replace-priority": 400,
				"replace": {
					"resources/app/Bootstrap.php": "app",
					"resources/app/app.neon": "app",
					"resources/www": "www"
				}
			}
		},
		"drago-translator": {
			"translation": "app/Presentation/Install/Translate"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"post-install-cmd": [
			"drago-install --dev",
			"drago-clean"
		],
		"post-update-cmd": [
			"drago-install --dev",
			"drago-clean"
		],
		"tester": "tester tests -s -C"
	}
}
